# Copy to .env.local and fill in.

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Any OpenRouter model id. For screenshots it must accept images.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Storage: "sheets" (Google Sheets) or "file" (data/store.json, handy for trying it out)
STORAGE=file

# Google Sheets (only when STORAGE=sheets)
# The spreadsheet id is the long part of its URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# Service account email and private key, from the JSON key file you download in Google Cloud.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Set to 1 to use canned AI responses instead of OpenRouter (development and tests only)
MOCK_AI=0
